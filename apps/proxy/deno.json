{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --watch src/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env",
    "lint": "deno lint src/"
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  }
}
