# -- REQUIRED: Hermes gateway authentication (change the values below!)
# Reference: https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard#authentication-gated-mode

# PREFERRED, Use nous portal OAuth
# NOTE: username/password auth is for trusted networks/VPN only. For public
# internet access, use the Nous Portal OAuth provider instead (see the docs link above).
#HERMES_DASHBOARD_OAUTH_CLIENT_ID=agent:xxxx

# or, use username & password auth
# NOTE: over plain http (no TLS), the password is transmitted in cleartext —
# put HTTPS in front for any non-local deployment.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=username
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=a-strong-password
#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$16384$8$1$…$…  # or use a hash
#HERMES_DASHBOARD_PUBLIC_URL=  # optional, set when you get into redirect_uri_mismatch

# RECOMMENDED if you use password auth, set it to keep sessions alive across restarts.
# generate your own with: openssl rand -hex 32
#HERMES_DASHBOARD_BASIC_AUTH_SECRET=


# -- WebUI Proxy configs, provided by this project

# whitelist of allowed targets for the proxy, including OAuth redirect urls, comma-separated
# set to empty to allow all
#WEB_PROXY_ALLOWED_TARGETS=http://hermes:9119

# default gateway URL in WebUI config
#WEB_DEFAULT_GATEWAY_URL=http://hermes:9119

# port for the WebUI
#WEB_PORT=6722

# OAuth redirect_uri 覆盖：必须填**本代理自己的 origin + /auth/native/callback**
# （如 https://webui.example.com/auth/native/callback）；留空 = 按请求 origin 推导。
# 别填 gateway 自己的地址（302 会回不到代理，code 交换必败）。
# 远端浏览器（浏览器 ≠ 代理机器）的 OAuth 登录需 SSH 隧道回连 loopback
# （README「安全模型」；上游只收 127.0.0.1/::1 redirect_uri，RFC 8252）。
#WEB_OAUTH_REDIRECT_URI=


# -- Other configs can load into hermes
# https://hermes-agent.nousresearch.com/docs/user-guide/configuration

#HERMES_UID=10000
#HERMES_GID=10000
#HERMES_DASHBOARD_PORT=9119
